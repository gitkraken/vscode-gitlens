{
	"name": "@gitlens/git-cli",
	"description": "GitLens Git CLI package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./cliGitProvider.js": "./src/cliGitProvider.ts",
		"./service.js": "./src/service.ts",
		"./exec/*.js": "./src/exec/*.ts",
		"./providers/*.js": "./src/providers/*.ts",
		"./parsers/*.js": "./src/parsers/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "pnpm run test:mocha && pnpm run test:node",
		"test:mocha": "mocha --require ../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 'src/**/__tests__/**/*.test.ts' --ignore 'src/**/__tests__/**/*.node.test.ts' --ignore 'src/**/__tests__/integration/**'",
		"test:node": "node --import ../../scripts/tsxTsconfig.cjs --import tsx --test 'src/**/__tests__/**/*.node.test.ts'",
		"test:integration": "mocha --require ../../scripts/tsxTsconfig.cjs --require tsx --require ./src/providers/__tests__/integration/rootHooks.ts --ui tdd --timeout 30000 'src/**/__tests__/integration/**/*.test.ts'"
	},
	"dependencies": {
		"@gitlens/git": "workspace:*",
		"@gitlens/utils": "workspace:*"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"@types/sinon": "catalog:",
		"mocha": "catalog:",
		"sinon": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
