{
	"name": "@gitlens/utils",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#env/*.js": {
			"node": "./src/env/node/*.ts",
			"default": "./src/env/browser/*.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./__tests__/*.js": null,
		"./decorators/*.js": "./src/decorators/*.ts",
		"./env/browser/*.js": null,
		"./env/node/exec.js": "./src/env/node/exec.ts",
		"./env/node/platform.js": "./src/env/node/platform.ts",
		"./env/node/*.js": null,
		"./keys/chord.js": "./src/keys/chord.ts",
		"./keys/keybinding.js": "./src/keys/keybinding.ts",
		"./*.js": "./src/*.ts"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit && oxlint --type-aware --type-check -c ../../.oxlintrc.json .",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "pnpm run test:mocha && pnpm run test:node",
		"test:mocha": "mocha --require ../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 'src/**/__tests__/**/*.test.ts' --ignore 'src/**/__tests__/**/*.node.test.ts'",
		"test:node": "node --import ../../scripts/tsxTsconfig.cjs --import tsx --test 'src/**/__tests__/**/*.node.test.ts'"
	},
	"dependencies": {
		"fast-string-truncated-width": "catalog:",
		"vscode-uri": "catalog:"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"@types/sinon": "catalog:",
		"mocha": "catalog:",
		"sinon": "catalog:",
		"tinybench": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
