{
	"name": "@gitlens/git",
	"description": "GitLens Git package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./cache.js": "./src/cache.ts",
		"./context.js": "./src/context.ts",
		"./errors.js": "./src/errors.ts",
		"./features.js": "./src/features.ts",
		"./gitHealth.js": "./src/gitHealth.ts",
		"./repositoryService.js": "./src/repositoryService.ts",
		"./run.types.js": "./src/run.types.ts",
		"./service.js": "./src/service.ts",
		"./models/*.js": "./src/models/*.ts",
		"./providers/*.js": "./src/providers/*.ts",
		"./providers/shared/*.js": "./src/providers/shared/*.ts",
		"./utils/*.js": "./src/utils/*.ts",
		"./remotes/*.js": "./src/remotes/*.ts",
		"./parsers/*.js": "./src/parsers/*.ts",
		"./watching/*.js": "./src/watching/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "pnpm run test:mocha && pnpm run test:node",
		"test:mocha": "mocha --require ../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 'src/**/__tests__/**/*.test.ts' --ignore 'src/**/__tests__/**/*.node.test.ts'",
		"test:node": "node --import ../../scripts/tsxTsconfig.cjs --import tsx --test 'src/**/__tests__/**/*.node.test.ts'"
	},
	"dependencies": {
		"@gitlens/utils": "workspace:*",
		"ignore": "catalog:"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vscode-uri": "catalog:"
	}
}
