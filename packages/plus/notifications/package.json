{
	"name": "@gitlens/notifications",
	"description": "GitLens GitKraken notifications package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./context.js": "./src/context.ts",
		"./errors.js": "./src/errors.ts",
		"./models.js": "./src/models.ts",
		"./notificationsService.js": "./src/notificationsService.ts",
		"./presentation.js": "./src/presentation.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "mocha --require ../../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 \"src/**/__tests__/**/*.test.ts\""
	},
	"dependencies": {
		"@gitlens/utils": "workspace:*"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
