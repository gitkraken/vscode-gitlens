{
	"name": "@gitkraken/commit-graph",
	"version": "0.1.0",
	"description": "High-performance, rendering-agnostic commit-graph engine and view model.",
	"author": {
		"name": "GitKraken",
		"url": "https://gitkraken.com"
	},
	"homepage": "https://github.com/gitkraken/vscode-gitlens/tree/main/packages/plus/commit-graph",
	"repository": {
		"type": "git",
		"url": "https://github.com/gitkraken/vscode-gitlens.git",
		"directory": "packages/plus/commit-graph"
	},
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		"./package.json": "./package.json",
		"./__tests__/*.js": null,
		"./engine/__tests__/*.js": null,
		"./lanes/__tests__/*.js": null,
		"./wip/__tests__/*.js": null,
		"./engine/*.js": {
			"types": "./dist/engine/*.d.ts",
			"default": "./dist/engine/*.js"
		},
		"./lanes/*.js": {
			"types": "./dist/lanes/*.d.ts",
			"default": "./dist/lanes/*.js"
		},
		"./wip/*.js": {
			"types": "./dist/wip/*.d.ts",
			"default": "./dist/wip/*.js"
		},
		"./a11y.js": {
			"types": "./dist/a11y.d.ts",
			"default": "./dist/a11y.js"
		},
		"./geometry.js": {
			"types": "./dist/geometry.d.ts",
			"default": "./dist/geometry.js"
		},
		"./l10n.js": {
			"types": "./dist/l10n.d.ts",
			"default": "./dist/l10n.js"
		},
		"./paging.js": {
			"types": "./dist/paging.d.ts",
			"default": "./dist/paging.js"
		},
		"./projection.js": {
			"types": "./dist/projection.d.ts",
			"default": "./dist/projection.js"
		},
		"./scope.js": {
			"types": "./dist/scope.d.ts",
			"default": "./dist/scope.js"
		},
		"./stats.js": {
			"types": "./dist/stats.d.ts",
			"default": "./dist/stats.js"
		},
		"./time.js": {
			"types": "./dist/time.d.ts",
			"default": "./dist/time.js"
		},
		"./zones.js": {
			"types": "./dist/zones.d.ts",
			"default": "./dist/zones.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"LICENSE.plus"
	],
	"publishConfig": {
		"provenance": false
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p tsconfig.json && oxlint --type-aware --type-check -c ../../../.oxlintrc.json .",
		"clean": "pnpx rimraf --glob dist LICENSE LICENSE.plus *.tgz",
		"prepack": "pnpm run build",
		"test": "mocha --require ../../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 \"src/**/__tests__/**/*.test.ts\"",
		"verify:package": "node scripts/verify-package.mjs"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "catalog:",
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"publint": "catalog:",
		"tinybench": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@vscode/l10n": "catalog:"
	}
}
