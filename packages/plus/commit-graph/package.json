{
	"name": "@gitkraken/commit-graph",
	"version": "0.1.0",
	"description": "High-performance, rendering-agnostic commit-graph engine and view model.",
	"author": {
		"name": "GitKraken",
		"url": "https://gitkraken.com"
	},
	"homepage": "https://github.com/gitkraken/vscode-gitlens/tree/main/packages/plus/commit-graph",
	"repository": {
		"type": "git",
		"url": "https://github.com/gitkraken/vscode-gitlens.git",
		"directory": "packages/plus/commit-graph"
	},
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		"./package.json": "./package.json",
		"./__tests__/*.js": null,
		"./engine/__tests__/*.js": null,
		"./engine/*.js": {
			"types": "./dist/engine/*.d.ts",
			"default": "./dist/engine/*.js"
		},
		"./*.js": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./theme.css": "./graph-default-theme.css"
	},
	"files": [
		"dist",
		"graph-default-theme.css",
		"README.md",
		"LICENSE",
		"LICENSE.plus"
	],
	"publishConfig": {
		"provenance": false
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"clean": "pnpx rimraf --glob dist LICENSE LICENSE.plus *.tgz",
		"lint:css": "stylelint graph-default-theme.css",
		"prepack": "node scripts/build.mjs",
		"test": "mocha --require tsx --ui tdd --timeout 30000 'src/**/__tests__/**/*.test.ts'",
		"verify:package": "node scripts/verify-package.mjs"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"tinybench": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
