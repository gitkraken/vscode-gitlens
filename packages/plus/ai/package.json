{
	"name": "@gitlens/ai",
	"description": "Gitlens AI package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./constants.js": "./src/constants.ts",
		"./errors.js": "./src/errors.ts",
		"./prompts.js": "./src/prompts.ts",
		"./models/*.js": "./src/models/*.ts",
		"./utils/*.js": "./src/utils/*.ts",
		"./providers/*.js": "./src/providers/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "mocha --require ../../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 'src/**/__tests__/**/*.test.ts'"
	},
	"dependencies": {
		"@gitlens/utils": "workspace:*",
		"@gitlens/git": "workspace:*"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
