{
	"name": "@gitlens/integrations",
	"description": "GitLens integrations package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "node scripts/test.mjs"
	},
	"exports": {
		"./constants.js": "./src/constants.ts",
		"./context.js": "./src/context.ts",
		"./errors.js": "./src/errors.ts",
		"./index.js": "./src/index.ts",
		"./integrationService.js": "./src/integrationService.ts",
		"./lite.js": "./src/lite.ts",
		"./telemetry.js": "./src/telemetry.ts",
		"./models/*.js": "./src/models/*.ts",
		"./authentication/*.js": "./src/authentication/*.ts",
		"./providers/*.js": "./src/providers/*.ts",
		"./providers/azure/*.js": "./src/providers/azure/*.ts",
		"./providers/bitbucket/*.js": "./src/providers/bitbucket/*.ts",
		"./providers/bitbucket-server/*.js": "./src/providers/bitbucket-server/*.ts",
		"./providers/github/*.js": "./src/providers/github/*.ts",
		"./providers/gitlab/*.js": "./src/providers/gitlab/*.ts",
		"./utils/*.js": "./src/utils/*.ts"
	},
	"dependencies": {
		"@gitkraken/provider-apis": "catalog:",
		"@gitlens/git": "workspace:*",
		"@gitlens/git-github": "workspace:*",
		"@gitlens/utils": "workspace:*"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"esbuild": "catalog:",
		"mocha": "catalog:",
		"typescript": "catalog:"
	}
}
