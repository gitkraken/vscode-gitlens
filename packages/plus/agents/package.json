{
	"name": "@gitlens/agents",
	"description": "GitLens Agents package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./agentCapabilities.js": "./src/agentCapabilities.ts",
		"./sanitizePrompt.js": "./src/sanitizePrompt.ts",
		"./stateMachine.js": "./src/stateMachine.ts",
		"./types.js": "./src/types.ts",
		"./providers/*.js": "./src/providers/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "mocha --require ../../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 --no-error-on-unmatched-pattern 'src/**/__tests__/**/*.test.ts'"
	},
	"dependencies": {
		"@gitlens/ipc": "workspace:*",
		"@gitlens/utils": "workspace:*"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
