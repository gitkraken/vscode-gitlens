{
	"name": "@gitlens/git-github",
	"description": "GitLens GitHub integration package",
	"version": "0.0.1",
	"license": "SEE LICENSE IN LICENSE",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./context.js": "./src/context.ts",
		"./models.js": "./src/models.ts",
		"./api/*.js": "./src/api/*.ts",
		"./providers/*.js": "./src/providers/*.ts",
		"./providers/github/*.js": "./src/providers/github/*.ts"
	},
	"scripts": {
		"build": "tsc -b",
		"clean": "pnpx rimraf --glob dist out **/tsconfig*.tsbuildinfo",
		"clean:all": "pnpm run clean && pnpm run clean:deps",
		"clean:deps": "pnpx rimraf --glob **/node_modules",
		"clean:lint": "pnpx rimraf --glob **/tsconfig*.tsbuildinfo",
		"test": "tsc -b && mocha --require ../../../scripts/tsxTsconfig.cjs --require tsx --ui tdd --timeout 30000 'src/**/__tests__/**/*.test.ts'"
	},
	"dependencies": {
		"@gitlens/git": "workspace:*",
		"@gitlens/utils": "workspace:*",
		"@octokit/graphql": "catalog:",
		"@octokit/request": "catalog:",
		"@octokit/request-error": "catalog:",
		"@octokit/types": "catalog:"
	},
	"devDependencies": {
		"@types/mocha": "catalog:",
		"mocha": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
